# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/logo_rekancucisepatu.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing examples only)
.env*
!.env.example
!deploy/*.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA files
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map

.vercel

.vercel

# local virtual environments
venv/
.venv/

# local storage / uploads / databases
storage/
uploads/
backups/*.json
database.sqlite
*.sqlite
*.sqlite3

# service credentials
credentials.json
service-account.json

# VS Code workspace settings
.vscode/
