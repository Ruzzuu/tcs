# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real secrets.

# Deployment identity: tcs or rekan
NEXT_PUBLIC_TENANT_ID=tcs

# MongoDB Atlas or local MongoDB connection string.
# Use a different database name for each deployment.
MONGODB_URI=mongodb://localhost:27017/cleaning-service
MONGODB_DB_NAME=cleaning-service

# Auth/session secrets. Use long random values in production.
JWT_SECRET=replace-with-random-64-hex-or-long-random-string
ADMIN_RECOVERY_KEY=replace-with-random-recovery-key
ADMIN_SEED_KEY=replace-with-random-seed-key
ADMIN_SEED_ENABLED=false

# Public app URL used for reset-password links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags. Set to true only when needed.
NEXT_PUBLIC_FEATURE_MULTI_ITEM=false
NEXT_PUBLIC_FEATURE_AUTO_MERGE=false

# Optional JSON object for deployment-specific service prices.
# Example: {"Deepclean":40000,"sewing":45000}
NEXT_PUBLIC_SERVICE_PRICE_OVERRIDES={}

# Cloudinary image uploads.
# Required for order photo upload/delete features.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_BASE_FOLDER=cleaning-app
